{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "brand": "HEADLINE.WORLD", "version": "1.0", "source": "BRAND.md", "date": "2026-08" },
  "color": {
    "core": {
      "ink": { "$value": "#0B0A0E", "$description": "Default background. Never pure black." },
      "ink-2": { "$value": "#131118", "$description": "Elevated dark surface (modals, popovers)." },
      "cream": { "$value": "#F7F1E6", "$description": "Text on dark; paper background in light mode. Never pure white." },
      "gold": { "$value": "#FFC93C", "$description": "Primary accent. One gold CTA per view. Ink text on gold." }
    },
    "palette": {
      "$description": "Canonical order = chart series order. Never reorder.",
      "1-pink": { "$value": "#F4356E", "sixJobs": "CREATE", "ui": "destructive/live" },
      "2-orange": { "$value": "#FF7A2F", "sixJobs": "BUILD", "ui": "warning/merch" },
      "3-gold": { "$value": "#FFC93C", "sixJobs": "DISTRIBUTE", "ui": "primary/booking" },
      "4-green": { "$value": "#3FCB86", "sixJobs": "CONNECT", "ui": "success/fans" },
      "5-blue": { "$value": "#38B6E8", "sixJobs": "MONETIZE", "ui": "info/money/AI" },
      "6-purple": { "$value": "#8B5CF6", "sixJobs": "SERVE", "ui": "premium/contracts" },
      "7-magenta": { "$value": "#FF4FA3", "sixJobs": null, "ui": "community" }
    },
    "deep": {
      "$description": "Light-mode text-safe variants, >=4.6:1 on cream.",
      "pink": { "$value": "#D70645" }, "orange": { "$value": "#BD4400" },
      "gold": { "$value": "#8C6500" }, "green": { "$value": "#1E7B4D" },
      "blue": { "$value": "#0E749D" }, "purple": { "$value": "#7B43F9" },
      "magenta": { "$value": "#D60066" }
    },
    "warm": {
      "$description": "Neutral ramp on ink. 700 and below decorative only.",
      "100": { "$value": "#F7F1E6" }, "200": { "$value": "#D9D2C6" },
      "300": { "$value": "#CFC8BC" }, "400": { "$value": "#B9B1A4" },
      "500": { "$value": "#9A9286" }, "600": { "$value": "#8E877C" },
      "700": { "$value": "#6E675C" }, "800": { "$value": "#4A443C" }
    },
    "surface": {
      "1": { "$value": "rgba(247,241,230,0.045)", "$description": "Card fill on ink" },
      "2": { "$value": "rgba(247,241,230,0.07)", "$description": "Hover card fill" },
      "rule-paper": { "$value": "#C9C2B4", "$description": "Printed rule lines on white write-surfaces" }
    }
  },
  "font": {
    "display": { "$value": "Archivo", "weights": [900, 800, 700, 400], "$description": "Display, headings, numbers, body, buttons." },
    "label": { "$value": "Oswald", "weights": [300, 400, 500], "$description": "Eyebrows, labels, nav, tags. Always uppercase + letterspaced. Never paragraphs, never italic." }
  },
  "tracking": {
    "eyebrow": { "$value": "0.26em" }, "label": { "$value": "0.20em" },
    "nav": { "$value": "0.16em" }, "display": { "$value": "-0.015em" }
  },
  "radius": {
    "default": { "$value": "6px" },
    "card": { "$value": "0 5px 5px 0", "$description": "Left-border card: square accent edge, rounded right." }
  },
  "size": {
    "accent-border": { "$value": "3px" },
    "rule": { "$value": "64px x 3px", "$description": "The accent rule under every H1." },
    "dot": { "$value": "10px", "gap": "9px" }
  },
  "motion": {
    "ease": { "$value": "cubic-bezier(0.2, 0.7, 0.3, 1)" },
    "fast": { "$value": "160ms" }, "enter": { "$value": "280ms" }
  }
}
