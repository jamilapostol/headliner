# ── Stripe ──────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_ while building.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Kit (formerly ConvertKit) ───────────────────────────────────────
# Kit → Settings → Developer. V4 API key.
KIT_API_KEY=
# Form IDs: Kit → Grow → Landing Pages & Forms → (form) → the ID is in the URL
KIT_FORM_BOOKING_PIPELINE=
KIT_FORM_TOUR_CHECKLIST=
KIT_FORM_MONTHLY_CHECKIN=
KIT_FORM_BUDGET_SPREADSHEET=
KIT_FORM_ALL_TOOLS=

# ── Resend (delivery email) ─────────────────────────────────────────
# resend.com → API Keys. Verify the headline.world domain first.
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=orders@headline.world

# ── Supabase ────────────────────────────────────────────────────────
# YOUR project (jamilapostol account) — Dashboard → Settings → API
# Run setup/migration.sql there first (creates tables + private bucket).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key is SERVER-ONLY. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCTS_BUCKET=artist-operator-files

# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://headline.world
