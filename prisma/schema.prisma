// HEADLINE. — data model
// Postgres via Supabase. Auth is owned by Supabase (the auth.users table,
// not modeled here) — Membership.userId stores that auth user's id as a
// plain string; there's no local User table or password storage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (transaction mode, port 6543) — app runtime
  directUrl = env("DIRECT_URL") // pooled (session mode, port 5432) — migrations/db push
}

enum Role {
  artist
  manager
  agent
  tour_manager
  merch
  accountant
  assistant
}

enum Plan {
  free
  pro
  touring
  team
  beta // admin-granted, full Pro-tier access for early testers — not self-serve, not billed
}

enum BookingStage {
  Lead
  Contacted
  Negotiating
  Offer_Sent
  Confirmed
  Paid
}

enum ContactCategory {
  Venues
  Promoters
  Festivals
  Media
  Sponsors
  Hosts
}

enum TransactionKind {
  income
  expense
}

model Workspace {
  id                String    @id @default(cuid())
  name              String
  plan              Plan      @default(free)
  billingCycle      String    @default("monthly") // monthly | annual
  stripeCustomerId  String?
  stripeSubId       String?
  paymentPastDue    Boolean   @default(false) // set by the payment_failed webhook, cleared on next successful invoice
  cancelAtPeriodEnd Boolean   @default(false) // downgrade-to-free is scheduled; stays on current plan until the period ends
  currentPeriodEnd  DateTime? // synced from Stripe — when the scheduled downgrade takes effect
  trialEndsAt       DateTime?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  createdAt         DateTime  @default(now())

  // Referral program. referredByWorkspaceId is a loose reference (not a
  // Prisma relation) to the workspace whose invite link this one signed up
  // through — set once at signup, never changed. referralRewardIssuedAt
  // marks that this workspace's first paid conversion already triggered
  // its referrer's reward, so the webhook can't double-grant it.
  // referralCreditsEarned counts rewards *this* workspace has earned by
  // referring others.
  referredByWorkspaceId  String?
  referralRewardIssuedAt DateTime?
  referralCreditsEarned  Int       @default(0)

  // Whether merch income joins the pool that Split rows divide. Off is a
  // real and common arrangement — plenty of bands split show fees but leave
  // merch with whoever fronted the print run — so it is a stored choice
  // rather than an assumption baked into the math.
  splitsIncludeMerch Boolean @default(true)

  memberships  Membership[]
  contacts     Contact[]
  bookings     Booking[]
  transactions Transaction[]
  liabilities  Liability[]
  tasks        Task[]
  tours        Tour[]
  merchItems   MerchItem[]
  splits       Split[]
  payouts      Payout[]
  contracts    Contract[]
  fans         Fan[]
  campaigns    Campaign[]
  aiUsage      AiUsage[]
  automations  Automation[]
  integrations Integration[]
}

// Admin allowlist entries added from the admin panel, layered on top of the
// ADMIN_EMAILS env var (which stays authoritative as a bootstrap list so
// access can never be fully locked out by a bad DB state).
model AdminUser {
  email     String   @id
  addedBy   String
  createdAt DateTime @default(now())
}

// Shareable codes that grant the "beta" plan on redemption — how the beta
// program stays invite-only instead of a self-serve signup option.
// maxUses null = unlimited redemptions; active=false is a soft revoke that
// keeps the row (and its usage count) around for the admin view.
model BetaInvite {
  code      String   @id
  maxUses   Int?
  usedCount Int      @default(0)
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
}

// Idempotency ledger for offline-queued merch mutations (adjustStock,
// completeSale) — see src/lib/merch-offline.ts. A device at a merch table
// with bad signal queues an action locally and retries it on reconnect;
// without this table a retried request would sell the same inventory or
// log the same revenue twice.
//
// The (workspaceId, key) unique constraint is the whole mechanism: claiming
// a key is a single `INSERT ... ON CONFLICT DO NOTHING`, which can't throw,
// so it's safe inside the same transaction as the mutation it guards (a
// caught Postgres error aborts the rest of that transaction — a pattern
// this deliberately avoids). A conflict means "already applied or in
// flight" — resultJson holds what to hand back to a replay without
// re-running the effect. An empty resultJson on a conflicting row means a
// prior attempt claimed the key but never finished (crash, or another tab
// racing at this instant); the caller treats that as retryable rather than
// waiting on it.
model MerchSyncOperation {
  id          String   @id @default(cuid())
  workspaceId String
  key         String // client-generated UUID, one per queued action
  action      String // "adjustStock" | "completeSale"
  resultJson  String // "" until the effect completes; then the JSON to replay verbatim
  createdAt   DateTime @default(now())

  @@unique([workspaceId, key])
  @@index([createdAt])
}

// One row per recipient per event type, written by the Resend webhook.
// Storing events rather than incrementing a counter is what makes opens
// unique: a recipient who opens the same email six times must count once,
// and a webhook that redelivers must not inflate the rate.
model CampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  email      String
  type       String // "delivered" | "opened" | "clicked" | "bounced" | "complained"
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email, type])
  @@index([campaignId])
}

// Server-action failures, so they're visible somewhere other than a Vercel
// runtime log nobody reads. Written by withErrorLog/withErrorState in
// src/lib/action-error.ts, which never lets a failed write here mask the
// original error. Deliberately has no relations — an error is worth
// recording even when the row it concerned is gone.
model ActionError {
  id          String   @id @default(cuid())
  label       String // the server action's name, e.g. "generateFollowupDraft"
  message     String
  stack       String?
  workspaceId String? // best-effort; absent when the failure preceded session lookup
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([label])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // e.g. "workspace.plan.update", "record.create", "record.update", "record.delete", "impersonate.start"
  targetType String // model key, or "workspace"
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Self-cleaning hit counter for anti-abuse rate limiting (login, signup,
// password reset). Stale rows for a key are deleted on each check, so this
// never grows beyond the currently-active window per key. See src/lib/rate-limit.ts.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String // Supabase auth.users.id
  role        Role      @default(artist)
  invitedBy   String?
  acceptedAt  DateTime? // null while an invite is pending
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Contact {
  id              String          @id @default(cuid())
  workspaceId     String
  name            String
  org             String?
  role            String?
  category        ContactCategory @default(Venues)
  city            String?
  email           String?
  phone           String?
  strength        Int             @default(3) // 1-5
  lastContactedAt DateTime?
  notes           String?
  createdAt       DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([workspaceId])
}

model Booking {
  id               String       @id @default(cuid())
  workspaceId      String
  contactId        String?
  venue            String
  city             String
  date             DateTime
  endDate          DateTime? // null for a single-day booking
  stage            BookingStage @default(Lead)
  fee              Int          @default(0) // cents
  deposit          Int          @default(0) // cents
  // The venue's cut of merch sales, in basis points (2000 = 20%). Venues
  // commonly take 20-35% off the top and it is rarely written down anywhere
  // the artist looks again, so it is stored per-show rather than assumed.
  merchCutBps      Int          @default(0)
  // IANA zone for the venue, e.g. "America/Los_Angeles". Null means unknown,
  // which is the honest default: it cannot be inferred from a city name
  // without guessing. `date` above stays a plain calendar marker stored at
  // UTC midnight — this is not a time-of-day for the show, it is what
  // decides when "tonight" begins and ends at that venue.
  timezone         String?
  contactName      String?
  contactPhone     String?
  notes            String?
  offerConfirmed   Boolean      @default(false)
  contractSigned   Boolean      @default(false)
  depositReceived  Boolean      @default(false)
  riderSent        Boolean      @default(false)
  // Set the first time this booking's stage becomes "Paid" — points at the
  // income Transaction auto-created for its fee, so re-saving the stage
  // (or dragging back and forth) can't log the same revenue twice.
  feeTransactionId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id])
  tourStop     TourStop?
  transactions Transaction[]

  @@index([workspaceId])
}

model Tour {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stops     TourStop[]

  @@index([workspaceId])
}

model TourStop {
  id           String  @id @default(cuid())
  tourId       String
  bookingId    String? @unique
  seq          Int
  driveMiles   Int?
  hotel        String?
  hotelConfNo  String?
  merchNote    String?
  perDiemCents Int? // daily per diem budget, in cents
  schedule     String // JSON-encoded array of { time, what, who }

  tour    Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([tourId])
}

model MerchItem {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  variant     String?
  price       Int // cents
  cogs        Int // cents
  stock       Int      @default(0)
  maxStock    Int      @default(1)
  glyph       String   @default("M")
  color       String   @default("#3fe87a")
  imageUrl    String? // public URL in the "merch" storage bucket
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum ContractStatus {
  DRAFT
  AWAITING_SIGN
  SIGNED
  ACTIVE
}

model Contract {
  id           String         @id @default(cuid())
  workspaceId  String
  name         String
  kind         String
  counterparty String
  value        String
  status       ContractStatus @default(DRAFT)
  signedDate   DateTime?
  renewsAt     DateTime?
  filePath     String? // path within the private "contracts" storage bucket
  fileName     String? // original filename, for display
  createdAt    DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Task {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  dueLabel    String
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Transaction {
  id          String          @id @default(cuid())
  workspaceId String
  kind        TransactionKind
  category    String
  amount      Int // cents; expenses stored positive, kind marks sign
  source      String?
  receiptUrl  String? // path within the private "receipts" bucket; served via /api/transactions/[id]/receipt
  // Which show this money belongs to. Null is the norm, not an error: most
  // transactions are tour-wide (van repair, a month of rehearsal space) and
  // genuinely belong to no single night. The settlement screens surface
  // untagged money in the tour window as "unallocated" rather than hiding
  // it, so the gap is visible work rather than a silent omission.
  bookingId   String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// Manual liabilities entry for the Finance balance sheet — this app has no
// bank/loan integration, so debts are simply self-reported.
// Who gets what share of tour profit. Shares are basis points (2500 = 25%)
// because percentages with decimals do not survive repeated rounding: three
// people on "33.33%" must still add to exactly 100, and integer bps make
// that checkable. Deliberately NOT tied to Membership — the drummer who
// gets 15% often has no login, and gating a payout on account creation
// would make the feature useless on the first tour it is needed for.
model Split {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  role        String?
  shareBps    Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A share actually handed over. Splits say who is owed what; this says what
// has been settled, which is the difference between a calculation and a
// ledger — without it the splits screen shows the same numbers forever and
// nobody can tell who has been paid.
//
// `name` is a snapshot, not a join. A person removed from the split table
// after a tour must not take their payment history with them; that history
// is the record of money that actually moved.
model Payout {
  id          String   @id @default(cuid())
  workspaceId String
  splitId     String? // null once the split row is gone; name survives
  name        String
  tourId      String?
  amount      Int // cents
  method      String? // free text — "Bank transfer", "Venmo", "Cash"
  note        String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([splitId])
}

model Liability {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  amount      Int // cents
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum FanTier {
  VIP
  Patron
  Donor
  Fan
}

model Fan {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  email         String?
  phone         String?
  city          String?
  tier          FanTier  @default(Fan)
  tierNote      String?
  lifetimeSpend Int      @default(0) // cents
  showsAttended Int      @default(0)
  lastSeenLabel String?
  notes         String?
  unsubscribed  Boolean  @default(false)
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum CampaignStatus {
  Draft
  Sending
  Sent
  Failed
}

// One row per workspace per calendar month ("2026-08") counting Roadie AI
// calls — bounds the platform's Anthropic bill the same way MONTHLY_EMAIL_CAP
// bounds the Resend bill. Only real Claude calls increment it; template
// fallbacks (no API key) are free and uncounted.
model AiUsage {
  id          String @id @default(cuid())
  workspaceId String
  month       String
  count       Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month])
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  subject        String         @default("")
  body           String         @default("") // plain text; sent as the email body
  audienceTier   FanTier? // null = all subscribed fans
  status         CampaignStatus @default(Draft)
  recipientCount Int            @default(0) // set when queued; actual send count once sent
  sentAt         DateTime?
  openRate       Float          @default(0)
  clickRate      Float          @default(0)
  revenue        Int? // cents; null when not applicable (e.g. patron updates)
  createdAt      DateTime       @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    CampaignEvent[]

  @@index([workspaceId])
}

model Automation {
  id          String  @id @default(cuid())
  workspaceId String
  key         String
  name        String
  trigger     String
  enabled     Boolean @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  key         String // gmail | gcal | stripe | square | spotify | bit
  connected   Boolean   @default(false)
  connectedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// Editable marketing copy for the public landing page. Not workspace-scoped —
// this is site-wide content. A missing row for a given key just means "use
// the code default" (see src/lib/site-content.ts), so this table can be
// empty and the landing page still renders correctly.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Admin-addable sections on the public landing page, rendered in `order`
// between the built-in Features and Pricing sections. type discriminates
// which fields are used: "text" reads heading/body, "image" reads
// imageUrl/imageAlt.
model LandingBlock {
  id        String   @id @default(cuid())
  type      String
  order     Int      @default(0)
  heading   String?
  body      String?
  imageUrl  String?
  imageAlt  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Public web pages managed from /admin/pages. "system" rows gate the
// hardcoded marketing routes (/, /landing, /beta) — only their visibility is
// editable. "custom" rows are admin-authored pages rendered at /<slug>.
model WebPage {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  kind       String   @default("custom") // system | custom
  visibility String   @default("private") // public | private
  heading    String?
  body       String? // custom pages: blank-line-separated paragraphs
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
